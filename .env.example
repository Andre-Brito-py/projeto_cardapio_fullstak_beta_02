# Conexão com o PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardapio?schema=public"

# Segredo usado para assinar a sessão (cookie). Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres"

# URL pública da aplicação (usada em links compartilháveis)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
